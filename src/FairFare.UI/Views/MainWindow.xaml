<Window x:Class="FairFare.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="FairFare" Height="740" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TabControl Grid.Row="1">
            <TabItem Header="Trip">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Trip title" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding TripTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <Button Content="Create trip" Command="{Binding CreateTripCommand}" Padding="8,4" Margin="0,0,0,16"/>

                        <TextBlock Text="Add participant" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ParticipantName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <Button Content="Add participant" Command="{Binding AddParticipantCommand}" Padding="8,4"/>

                        <ListBox ItemsSource="{Binding Participants}" Margin="0,12,0,0" Height="220"/>
                    </StackPanel>

                    <Border Grid.Column="1" Padding="16" Background="#F8FBFF" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="Trip overview" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding TripSummary}" TextWrapping="Wrap" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Expenses">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Description" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Amount" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ExpenseAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Payer" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Payers}" SelectedItem="{Binding SelectedPayer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <Button Content="Add expense" Command="{Binding AddExpenseCommand}" Padding="8,4"/>
                    </StackPanel>

                    <Border Grid.Column="1" Padding="16" Background="#F7FAFF" CornerRadius="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ExpenseSummary}" TextWrapping="Wrap" FontSize="14"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Balances">
                <Border Margin="12" Padding="16" Background="#F7FAFF" CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding BalanceSummary}" FontSize="15" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Route">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.9*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Location name" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding RouteLocationName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Order" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding RouteOrder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <Button Content="Add route location" Command="{Binding AddRouteLocationCommand}" Padding="8,4"/>
                    </StackPanel>

                    <Border Grid.Column="1" Padding="16" Background="#F7FAFF" CornerRadius="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding RouteSummary}" TextWrapping="Wrap" FontSize="14"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Report">
                <Border Margin="12" Padding="16" Background="#F7FAFF" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Content="Generate report" Command="{Binding GenerateReportCommand}" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReportSummary}" FontSize="14" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
